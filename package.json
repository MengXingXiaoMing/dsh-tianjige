{
  "name": "dsh-tianjige",
  "version": "1.3.0",
  "description": "天机阁 · 算法天书：把 219 门图形/动画/物理/AI 算法连同现成实现链接，做成 agent 可直接查询的工具（检索 · 档案 · 问天书 · 复核 · 体检），自带起始库，装完即用。",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "test": "node --test test/smoke.test.mjs",
    "check": "node --check host.js && node --check lib/sweep.mjs && node --check lib/ai.mjs && node --check lib/entries.mjs && node --check lib/usage.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "algorithms",
    "graphics",
    "rendering"
  ],
  "main": "host.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MengXingXiaoMing/dsh-tianjige.git"
  },
  "bugs": {
    "url": "https://github.com/MengXingXiaoMing/dsh-tianjige/issues"
  },
  "homepage": "https://github.com/MengXingXiaoMing/dsh-tianjige#readme",
  "exports": {
    ".": "./host.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "host.js",
    "index.js",
    "lib",
    "seed",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "test",
    "LICENSE",
    "README.md",
    "README-zh.md",
    "README-es.md",
    "README-pt.md",
    "README-hi.md"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
