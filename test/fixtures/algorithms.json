                    {
                        "id":  "noise-worley",
                        "name":  "Worley / Cellular Noise",
                        "aliases":  [
                                        "Worley Noise",
                                        "Cellular Noise",
                                        "Feature Point Noise",
                                        "Voronoi Noise"
                                    ],
                        "domain":  "procedural",
                        "subdomain":  "noise",
                        "functionKey":  "cellular-noise",
                        "functionLabel":  "细胞噪声",
                        "summary":  "在空间散布特征点，用「到最近若干个特征点的距离」当噪声值，生成细胞、裂纹、石砾质感。",
                        "howItWorks":  "把空间切成网格，每格用哈希生成一个特征点。对采样点，只检查所在格及相邻 3^n-1 个格（2D 9 格、3D 27 格），算出到最近 k 个特征点的距离并排序得到 F1、F2、F3…。F1 单独用是细胞团块，F2-F1 是细胞边界（裂纹/马赛克），F1×F2 之类的组合可做岩石与鳞片。距离度量可换欧氏/曼哈顿/切比雪夫，得到方角或菱形细胞。",
                        "whyItMatters":  "它是唯一能直接给出「区块边界」的噪声：石头开裂、干裂土地、马赛克、生物细胞、以及地牢房间的天然分区，都靠 F2-F1 一步得到，不需要额外边缘检测。",
                        "tradeoffs":  "比 Perlin 贵得多（2D 要查 9 个格、3D 27 个），单次采样成本约为梯度噪声的 5-10 倍；且 F1 场在山脊处不可导，直接当地形高度会得到大量尖角。要平滑需和梯度噪声混合。",
                        "complexity":  "O(3^n · k) 每采样点（3D 约 27 次距离计算）",
                        "inputs":  [
                                       "坐标",
                                       "特征点密度/网格尺寸",
                                       "距离度量",
                                       "k 值"
                                   ],
                        "outputs":  [
                                        "F1..Fk 距离值",
                                        "细胞 ID"
                                    ],
                        "quality":  4,
                        "performance":  2,
                        "difficulty":  3,
                        "maturity":  "production",
                        "year":  1996,
